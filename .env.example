# ═══════════════════════════════════════════════════════════════════════════
# ZaloPay AI Creative Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# API keys must remain server-side only — never expose to the frontend.
# ═══════════════════════════════════════════════════════════════════════════

# ── Active provider ──────────────────────────────────────────────────────────
# Which provider the platform uses by default.
# Supported values: gemini | openai | claude
AI_DEFAULT_PROVIDER=gemini

# ── Google Gemini (text generation + image analysis) ─────────────────────────
# Required. Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model for text generation and image analysis (default: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# Fallback models tried in order when the primary hits quota/rate-limit
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Request timeout in milliseconds (default: 30000)
GEMINI_TIMEOUT_MS=30000

# Maximum retry attempts before propagating the error (default: 3)
GEMINI_MAX_RETRIES=3

# ── Google Image Generation (gemini-3-pro-image) ─────────────────────────────
# Uses a separate GOOGLE_API_KEY. If not set, falls back to GEMINI_API_KEY.
# Obtain from https://aistudio.google.com/apikey (same console, may need billing)
#
# IMPORTANT: Image generation requires billing to be enabled on your
# Google AI Studio account. Free-tier limit for image models is 0.
# Enable billing at: https://aistudio.google.com
GOOGLE_API_KEY=

# Model for image generation
GOOGLE_IMAGE_MODEL=gemini-3-pro-image

# Fallback models (only if the primary is unavailable)
GOOGLE_IMAGE_FALLBACK_MODELS=gemini-3-pro-image

# Image generation timeout in ms (default: 90000 — generation can take 30–90s)
GOOGLE_IMAGE_TIMEOUT_MS=90000

# Maximum retry attempts for image generation (default: 2)
GOOGLE_IMAGE_MAX_RETRIES=2

# ── Supabase Storage (generated image persistence) ───────────────────────────
# When configured, generated images are uploaded to Supabase Storage and
# a permanent public URL is returned. When NOT configured (local dev),
# images are returned as data: URLs — no persistence.
#
# Setup:
#   1. Create a Supabase project at https://supabase.com
#   2. Create a bucket named "generated-images" in Storage → Buckets
#   3. Enable public reads on the bucket (Storage → Policies)
#   4. Copy the project URL and service role key below
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Higgsfield CLI (image generation — /api/image/generate) ─────────────────
# No API key needed. Auth lives in the CLI session:
#   npm install -g @higgsfield/cli
#   higgsfield auth login
#   higgsfield workspace set <workspace_id>
#
# Default model. Supported values:
#   nano-banana-pro (default) | nano-banana-2 | nano-banana-2-lite
HIGGSFIELD_MODEL=nano-banana-pro

# Fallback model when primary fails
HIGGSFIELD_FALLBACK_MODELS=nano-banana-2

# Generation timeout in ms (default: 110000 — CLI --wait blocks until done)
HIGGSFIELD_TIMEOUT_MS=110000

# Maximum retry attempts (default: 1)
HIGGSFIELD_MAX_RETRIES=1

# ── OpenAI (future) ──────────────────────────────────────────────────────────
# Leave blank until OpenAIProvider is implemented (lib/ai/providers/openai.ts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODELS=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=3

# ── Anthropic Claude (future) ────────────────────────────────────────────────
# Leave blank until ClaudeProvider is implemented (lib/ai/providers/claude.ts)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_FALLBACK_MODELS=claude-haiku-4-5
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_RETRIES=3

# ── Video Generation (future) ────────────────────────────────────────────────
# Uncomment when the provider is implemented
# VEO_API_KEY=
# RUNWAY_API_KEY=

# ── Application settings ─────────────────────────────────────────────────────
# Language for AI-generated report text: "vi" (Vietnamese) or "en" (English)
REPORT_LANGUAGE=vi

# Override path to brand guideline JSON (absolute or relative to project root)
# BRAND_GUIDELINE_PATH=./brand-guideline.json

# Override path to primary logo PNG
# LOGO_PATH=./assets/logo-primary.png
